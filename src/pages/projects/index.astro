---
// src/pages/projects/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Layout>
  <div class="max-w-4xl mx-auto py-10 animate-fade-in">
    <header class="mb-12">
      <a href="/" class="inline-flex items-center gap-2 text-cyan-400 hover:text-cyan-300 text-sm font-medium mb-8 transition-colors">
        <span>&larr;</span> Back to Home
      </a>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">All Projects 🚀</h1>
      <p class="text-xl text-gray-400 leading-relaxed">
        A complete archive of my engineering projects, from AI to Cloud Infrastructure.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedProjects.map((project) => (
        <a href={`/projects/${project.id}`} class="group flex flex-col bg-gray-900/40 border border-gray-800 hover:border-gray-700 rounded-xl p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-cyan-900/10">
          <div class="flex gap-2 mb-4 flex-wrap">
            {/* 1. Ambil maksimal 3 chip pertama */}
            {project.data.techStack.slice(0, 3).map((tech) => (
                <span class="inline-flex items-center justify-center px-2.5 py-1 text-[11px] font-medium rounded-full bg-cyan-950/30 text-cyan-400 border border-cyan-800/50 whitespace-nowrap">
                {tech}
                </span>
            ))}
            
            {/* 2. Hitung sisanya, jika lebih dari 0, tampilkan chip "+" */}
            {project.data.techStack.length > 3 && (
                <span class="inline-flex items-center justify-center px-2 py-1 text-[11px] font-medium rounded-full bg-gray-900 text-gray-400 border border-gray-800 whitespace-nowrap">
                +{project.data.techStack.length - 3}
                </span>
            )}
          </div>
          <h2 class="text-2xl font-bold text-gray-200 group-hover:text-cyan-400 transition-colors mb-3">
            {project.data.title}
          </h2>
          <p class="text-gray-400 text-sm mb-6 flex-grow">
            {project.data.description}
          </p>
          <div class="text-xs text-gray-500 font-mono pt-4 border-t border-gray-800/50 mt-auto">
            {project.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>