---
// src/pages/projects/[slug].astro
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

// Cek apakah ada link github
const hasGithub = project.data.githubUrl !== undefined;
---

<Layout>
  <article class="max-w-4xl mx-auto py-10 animate-fade-in">
    
    <a href="/#projects" class="inline-flex items-center gap-2 text-cyan-400 hover:text-cyan-300 text-sm font-medium mb-10 transition-colors">
      <span>&larr;</span> Back to Portfolio
    </a>
    
    <header class="mb-12">
      <h1 class="text-4xl md:text-6xl font-bold text-white mb-6 leading-tight">
        {project.data.title}
      </h1>
      <p class="text-xl md:text-2xl text-gray-400 font-light mb-8 max-w-3xl leading-relaxed">
        {project.data.description}
      </p>

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 border-y border-gray-800 py-6">
        <div class="flex flex-wrap gap-2">
          {project.data.techStack.map((tech) => (
            <span class="inline-flex items-center justify-center px-3 py-1.5 text-[11px] font-medium rounded-full bg-cyan-950/30 text-cyan-400 border border-cyan-800/50 whitespace-nowrap">
              {tech}
            </span>
          ))}
        </div>

        {hasGithub && (
          <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gray-900 hover:bg-gray-800 text-white font-medium rounded-lg border border-gray-700 transition-all shadow-lg hover:shadow-cyan-900/20 whitespace-nowrap">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
            View Source
          </a>
        )}
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-8">
        <div class="markdown-body">
          <Content />
        </div>
      </div>
      
      <aside class="lg:col-span-4 space-y-6">
        <div class="bg-gray-900/50 border border-gray-800 rounded-xl p-6">
          <h3 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-4">Project Overview</h3>
          <ul class="space-y-4 text-sm text-gray-300">
            <li>
              <span class="block text-gray-500 mb-1">Status</span>
              <span class="text-emerald-400 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Completed
              </span>
            </li>
            <li>
              <span class="block text-gray-500 mb-1">Date</span>
              {project.data.publishDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}
            </li>
          </ul>
        </div>
      </aside>
    </div>

  </article>
</Layout>

<style is:global>
  /* Pertahankan styling markdown-body dari sebelumnya di sini */
  .markdown-body { color: #9ca3af; font-size: 1.125rem; line-height: 1.8; }
  .markdown-body h2 { color: #ffffff; font-size: 1.75rem; font-weight: 700; margin-top: 3rem; margin-bottom: 1rem; }
  .markdown-body p { margin-bottom: 1.5rem; }
  .markdown-body ul { list-style-type: disc; padding-left: 1.5rem; margin-bottom: 2rem; }
  .markdown-body li { margin-bottom: 0.5rem; }
  .markdown-body strong { color: #f3f4f6; font-weight: 600; }
  /* (Lanjutkan dengan CSS markdown yang sudah ada) */
    /* 2. Style untuk MULTIBARIS CODE CONTAINER (Kotak utama) */
  .markdown-body pre {
    padding: 1.25rem !important; /* Memberikan ruang lega di sisi dalam kotak */
    border-radius: 0.5rem !important; /* Membuat sudut kotak lebih membulat (rounded-lg) */
    overflow-x: auto !important; /* Memunculkan scrollbar jika kode terlalu panjang ke samping */
    margin-top: 1rem; /* Jarak luar dengan paragraf di atasnya */
    margin-bottom: 1rem; /* Jarak luar dengan paragraf di bawahnya */
  }

  /* 3. RESET style untuk teks di dalam kotak multibaris agar rapi */
  .markdown-body pre code {
    background-color: transparent !important; /* Menghilangkan bg ganda */
    color: inherit !important; /* Menjaga warna syntax highlight bawaan */
    padding: 0 !important; /* Menghilangkan padding ganda karena pre sudah punya padding */
    border-radius: 0 !important; /* Menghilangkan border-radius ganda */
  }
</style>