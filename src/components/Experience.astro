---
// src/components/Experience.astro

const experiences = [
  {
    role: "AWS re/Start Graduate",
    company: "Amazon Web Services (AWS) Training Program",
    period: "Oct 2025 - Dec 2025",
    achievements: [
      "Cloud Incident Response & Forensics: Accelerated security incident mitigation by conducting real-time digital forensics on log anomalies, utilizing SQL queries in Amazon Athena to analyze thousands of AWS CloudTrail logs.",
      "Architecture Modernization: Modernized legacy monolith architectures into highly available microservices by building application containers with Docker, deploying to Amazon ECS & ECR, and managing network traffic via Application Load Balancer (ALB).",
      "FinOps & Optimization: Projected up to a 50% reduction in cloud compute costs through FinOps audits, legacy workload cleanup, and programmatic downsizing of Amazon EC2 instances via the AWS CLI."
    ]
  },
  {
    role: "UX/UI Research & Frontend Developer Intern",
    company: "UIN Sunan Gunung Djati",
    period: "Aug 2024 - Dec 2024",
    achievements: [
      "Translated stakeholder requirements into functional prototypes and mapped end-to-end help desk workflows, improving system structure, issue tracking, and cross-team communication."    ]
  }
];

const education = [
  {
    role: "Bachelor of Informatics Engineering (S1)",
    company: "UIN Sunan Gunung Djati Bandung",
    period: "Graduated Feb 2026",
    achievements: [
      "Specialization: Deep Learning, Computer Vision, and Cloud Infrastructure.",
      "Thesis / Final Project: Authored research on 'Medical Image Deepfake Detection utilizing YOLOv11', performing hyperparameter tuning with Optuna to optimize performance.",
      "Validation: Successfully proved model reliability through Stratified K-Fold Cross-Validation, effectively preventing data leakage and overfitting scenarios."
    ]
  }
];
---

<section id="experience" class="py-10 md:py-16 border-t border-gray-800/50 scroll-mt-8">
  <div class="mb-14">
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Experience & Education</h2>
    <p class="text-gray-400 max-w-2xl text-lg">
      My professional journey, technical training, and academic foundation.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-12">
    
    <div>
      <h3 class="text-2xl font-semibold text-cyan-400 mb-8 flex items-center gap-3">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
        Experience
      </h3>
      
      <div class="relative border-l border-gray-800 ml-3 space-y-12">
        {experiences.map((exp) => (
          <div class="relative pl-8 group">
            <div class="absolute w-4 h-4 bg-gray-950 border-2 border-cyan-500 rounded-full -left-[9px] top-1.5 shadow-[0_0_10px_rgba(34,211,238,0.4)] group-hover:scale-125 group-hover:bg-cyan-400 transition-all duration-300"></div>
            
            <div class="flex flex-col xl:flex-row xl:items-center justify-between mb-2 gap-2">
               <h4 class="font-bold text-white text-xl group-hover:text-cyan-400 transition-colors">{exp.role}</h4>
               <time class="text-xs font-mono text-cyan-400 px-3 py-1 bg-cyan-950/30 rounded-full border border-cyan-800/50 w-fit shrink-0">
                 {exp.period}
               </time>
            </div>
            
            <div class="text-md text-gray-300 font-medium mb-4">
              {exp.company}
            </div>
            
            <ul class="space-y-3 text-gray-400 text-[15px]">
              {exp.achievements.map((achieve) => (
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-gray-600 shrink-0 mt-0.5 group-hover:text-cyan-800 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                  <span class="leading-relaxed">
                    {achieve.includes(':') ? (
                      <>
                        <strong class="text-gray-200">{achieve.split(':')[0]}:</strong>
                        {achieve.split(':')[1]}
                      </>
                    ) : (
                      achieve
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div>
      <h3 class="text-2xl font-semibold text-cyan-400 mb-8 flex items-center gap-3">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path></svg>
        Academic Background
      </h3>
      
      <div class="relative border-l border-gray-800 ml-3 space-y-12">
        {education.map((edu) => (
          <div class="relative pl-8 group">
            <div class="absolute w-4 h-4 bg-gray-950 border-2 border-cyan-500 rounded-full -left-[9px] top-1.5 shadow-[0_0_10px_rgba(34,211,238,0.4)] group-hover:scale-125 group-hover:bg-cyan-400 transition-all duration-300"></div>
            
            <div class="flex flex-col xl:flex-row xl:items-center justify-between mb-2 gap-2">
               <h4 class="font-bold text-white text-xl group-hover:text-cyan-400 transition-colors">{edu.role}</h4>
               <time class="text-xs font-mono text-cyan-400 px-3 py-1 bg-cyan-950/30 rounded-full border border-cyan-800/50 w-fit shrink-0">
                 {edu.period}
               </time>
            </div>
            
            <div class="text-md text-gray-300 font-medium mb-4">
              {edu.company}
            </div>
            
            <ul class="space-y-3 text-gray-400 text-[15px]">
              {edu.achievements.map((achieve) => (
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-gray-600 shrink-0 mt-0.5 group-hover:text-cyan-800 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                  <span class="leading-relaxed">
                    {achieve.includes(':') ? (
                      <>
                        <strong class="text-gray-200">{achieve.split(':')[0]}:</strong>
                        {achieve.split(':')[1]}
                      </>
                    ) : (
                      achieve
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>