---
// src/components/FeaturedProjects.astro
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
// Ambil HANYA proyek yang isFeatured: true, urutkan dari yang terbaru
const featuredProjects = allProjects
  .filter(project => project.data.isFeatured)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<section id="projects" class="py-10 md:py-12 border-t border-gray-800/50">
  <div class="flex items-center justify-between mb-10">
    <div>
      <h2 class="text-3xl font-bold text-white mb-2">Featured Projects</h2>
      <p class="text-gray-400">Selected works in AI, Computer Vision, and Cloud.</p>
    </div>
    <a href="/projects" class="hidden md:block text-cyan-400 hover:text-cyan-300 text-sm font-medium transition-colors">
      View All Projects &rarr;
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {featuredProjects.map((project) => (
      <a href={`/projects/${project.id}`} class="group flex flex-col bg-gray-900/40 border border-gray-800 hover:border-gray-700 rounded-xl p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-cyan-900/10">
        
       <div class="flex gap-2 mb-4 flex-wrap">
          {/* 1. Ambil maksimal 3 chip pertama */}
          {project.data.techStack.slice(0, 3).map((tech) => (
            <span class="inline-flex items-center justify-center px-2.5 py-1 text-[11px] font-medium rounded-full bg-cyan-950/30 text-cyan-400 border border-cyan-800/50 whitespace-nowrap">
              {tech}
            </span>
          ))}
          
          {/* 2. Hitung sisanya, jika lebih dari 0, tampilkan chip "+" */}
          {project.data.techStack.length > 3 && (
            <span class="inline-flex items-center justify-center px-2 py-1 text-[11px] font-medium rounded-full bg-gray-900 text-gray-400 border border-gray-800 whitespace-nowrap">
              +{project.data.techStack.length - 3}
            </span>
          )}
        </div>
        
        <h3 class="text-2xl font-bold text-gray-200 group-hover:text-cyan-400 transition-colors mb-3">
          {project.data.title}
        </h3>
        <p class="text-sm text-gray-400 line-clamp-3 mb-6 flex-grow">
          {project.data.description}
        </p>
        
        <div class="flex items-center text-cyan-400 text-sm font-medium pt-4 border-t border-gray-800/50 mt-auto">
           Read Details <span class="ml-2 transform transition-transform group-hover:translate-x-1">&rarr;</span>
        </div>
      </a>
    ))}
  </div>
  
  <div class="mt-8 md:hidden text-center">
    <a href="/projects" class="inline-block text-cyan-400 hover:text-cyan-300 text-sm font-medium transition-colors">
      View All Projects &rarr;
    </a>
  </div>
</section>