---
// src/components/TechStack.astro

const coreExpertise = [
  { 
    title: "Cloud Infrastructure", 
    desc: "AWS ecosystem architecture, EC2 optimization, and FinOps practices.", 
    icon: "☁️",
    span: "md:col-span-2" // Kotak lebar
  },
  { 
    title: "DevSecOps", 
    desc: "Docker containerization and security auditing.", 
    icon: "🛡️",
    span: "md:col-span-1" // Kotak kecil
  },
  { 
    title: "AI & Vision", 
    desc: "YOLOv11 implementation and model optimizations.", 
    icon: "👁️",
    span: "md:col-span-1" 
  },
  { 
    title: "System Forensics", 
    desc: "Analyzing CloudTrail logs with Amazon Athena for incident response.", 
    icon: "🔍",
    span: "md:col-span-2" 
  },
];

const tools = [
  { name: "AWS", icon: "icloud" },
  { name: "Docker", icon: "docker" },
  { name: "Linux", icon: "linux" },
  { name: "Python", icon: "python" },
  { name: "PostgreSQL", icon: "postgresql" },
  { name: "LangChain", icon: "langchain" },
  { name: "TensorFlow", icon: "tensorflow" },
  { name: "React", icon: "react" },
  { name: "Git", icon: "git" },
  { name: "Amazon S3", icon: "icloud" }
];
---

<section id="skills" class="py-12 border-t border-gray-800/50 scroll-mt-8">
  <div class="mb-10">
    <h2 class="text-3xl font-bold text-white mb-2">Technical Arsenal</h2>
    <p class="text-gray-400">Core competencies and the technical "chain" of tools I use.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-12">
    {coreExpertise.map((item) => (
      <div class={`${item.span} p-6 bg-gray-900/40 border border-gray-800 rounded-2xl hover:border-cyan-500/50 transition-all group overflow-hidden relative flex flex-col items-center justify-center text-center`}>
        <div class="text-3xl mb-4">{item.icon}</div>
        <h3 class="text-xl font-bold text-gray-100 group-hover:text-cyan-400 transition-colors mb-2">{item.title}</h3>
        <p class="text-sm text-gray-400 leading-relaxed">{item.desc}</p>
        
        <div class="absolute -bottom-2 -right-2 w-12 h-12 bg-cyan-500/5 blur-2xl rounded-full"></div>
      </div>
    ))}
  </div>

  <div class="relative overflow-hidden py-4 group">
    <div class="absolute inset-y-0 left-0 w-20 bg-gradient-to-r from-gray-950 to-transparent z-10"></div>
    <div class="absolute inset-y-0 right-0 w-20 bg-gradient-to-l from-gray-950 to-transparent z-10"></div>

    <div class="flex whitespace-nowrap animate-marquee group-hover:[animation-play-state:paused] w-max">
      {/* Render dua kali untuk infinite loop */}
      {[...tools, ...tools].map((tool) => (
        <div class="mx-3 flex-none flex items-center justify-center gap-2.5 px-5 py-2.5 bg-gray-900/60 border border-gray-800 rounded-full text-gray-300 text-sm font-medium hover:border-cyan-500 hover:text-white transition-colors cursor-default">
          <img 
            src={`https:///cdn.simpleicons.org/${tool.icon}/22d3ee`} 
            alt={tool.name} 
            class="w-4 h-4 shrink-0 object-contain" 
            loading="lazy"
          />
          <span class="whitespace-nowrap leading-none mt-0.5">{tool.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>