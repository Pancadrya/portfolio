---
// src/components/LabNotes.astro
import { getCollection } from 'astro:content';

// Mengambil semua koleksi 'lab-notes' dan mengurutkannya dari yang terbaru
const allNotes = await getCollection('lab-notes');
const sortedNotes = allNotes.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

// Hanya ambil 3 catatan terbaru untuk ditampilkan di halaman depan
const recentNotes = sortedNotes.slice(0, 3);
---

<section id="lab-notes" class="py-10 md:py-12 border-t border-gray-800/50">
  <div class="flex items-center justify-between mb-10">
    <div>
      <h2 class="text-3xl font-bold text-white mb-2">Lab Notes & Digital Garden</h2>
      <p class="text-gray-400">Continuous learning and architectural experiments.</p>
    </div>
    <!-- Tombol "View All" (disembunyikan di layar HP, muncul di layar besar) -->
    <a href="/lab-notes" class="hidden md:block text-cyan-400 hover:text-cyan-300 text-sm font-medium transition-colors">
      View All Notes &rarr;
    </a>
  </div>

  <!-- Grid untuk Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {recentNotes.map((note) => (
      <a href={`/lab-notes/${note.id}`} class="group block bg-gray-900/40 border border-gray-800 hover:border-gray-700 rounded-xl p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-cyan-900/10">
        
        <!-- AWS Services Tags -->
       <div class="flex gap-2 mb-4 flex-wrap">
          {/* 1. Ambil maksimal 3 chip pertama */}
          {note.data.awsServices.slice(0, 3).map((tech) => (
            <span class="inline-flex items-center justify-center px-2.5 py-1 text-[11px] font-medium rounded-full bg-cyan-950/30 text-cyan-400 border border-cyan-800/50 whitespace-nowrap">
              {tech}
            </span>
          ))}
          
          {/* 2. Hitung sisanya, jika lebih dari 0, tampilkan chip "+" */}
          {note.data.awsServices.length > 3 && (
            <span class="inline-flex items-center justify-center px-2 py-1 text-[11px] font-medium rounded-full bg-gray-900 text-gray-400 border border-gray-800 whitespace-nowrap">
              +{note.data.awsServices.length - 3}
            </span>
          )}
        </div>
        
        <!-- Judul & Deskripsi -->
        <h3 class="text-xl font-bold text-gray-200 group-hover:text-cyan-400 transition-colors mb-3">
          {note.data.title}
        </h3>
        <p class="text-sm text-gray-400 line-clamp-3">
          {note.data.description}
        </p>
        
        <!-- Tanggal Publish -->
        <div class="mt-6 text-xs text-gray-500 font-mono">
          {note.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
        </div>
      </a>
    ))}
  </div>
  
  <!-- Tombol "View All" untuk layar HP -->
  <div class="mt-8 md:hidden text-center">
    <a href="/lab-notes" class="inline-block text-cyan-400 hover:text-cyan-300 text-sm font-medium transition-colors">
      View All Notes &rarr;
    </a>
  </div>
</section>