// src/components/Hero.astro
---

<section class="animate-fade-in pb-16 md:pb-24 mt-6 md:mt-8 scroll-mt-24">
  <div class="inline-flex items-center gap-2 px-4 py-1.5 mt-6 mb-8 text-sm font-medium text-cyan-400 bg-cyan-950/30 rounded-full border border-cyan-800/50 shadow-[0_0_15px_rgba(34,211,238,0.1)]">
    <span class="relative flex h-2.5 w-2.5">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-cyan-500"></span>
    </span>
    <a href="https://www.credly.com/badges/2b7e7aa6-8d01-4d6b-b26b-44b5a5765c87">AWS Certified Cloud Practitioner</a>
  </div>

  <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-6 text-white leading-tight">
    Cloud & AI Enthusiast. <br class="hidden md:block" />
    <span class="text-gray-500">Building intelligent systems.</span>
  </h1>

  <p class="max-w-2xl text-lg md:text-xl text-gray-400 mb-10 leading-relaxed">
    I am a Software Engineer focused on designing resilient cloud infrastructures and developing computer vision solutions. Currently diving deep into cloud security and architecture.
  </p>

  <div class="flex flex-wrap gap-4">
    <a href="#projects" class="px-6 py-3 bg-cyan-600 hover:bg-cyan-500 text-white font-semibold rounded-lg transition-transform hover:-translate-y-0.5 shadow-lg shadow-cyan-900/20 active:translate-y-0">
        View My Work &rarr;
    </a>
    <!-- Ganti href dengan URL LinkedIn kamu -->
    <a href="https://linkedin.com/in/pancadrya" target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-gray-900 hover:bg-gray-800 text-gray-300 font-semibold rounded-lg border border-gray-800 transition-transform hover:-translate-y-0.5 active:translate-y-0 flex items-center gap-2">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.447 20.452H16.89v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.346V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.268 2.37 4.268 5.455v6.286zM5.337 7.433a2.063 2.063 0 110-4.126 2.063 2.063 0 010 4.126zM7.119 20.452H3.555V9h3.564v11.452z"/>
        </svg>
        Connect on LinkedIn
