    <a href="/Panca Resume.pdf" download class="px-6 py-3 bg-transparent border border-gray-700 hover:border-cyan-500 text-gray-300 hover:text-white font-bold rounded-lg transition-all flex items-center gap-2 group">
          <svg class="w-5 h-5 group-hover:text-cyan-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
          Download Resume
