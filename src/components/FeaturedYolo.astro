---
// src/components/FeaturedYolo.astro
---

<section id="projects" class="py-16">
  <div class="flex items-center gap-4 mb-10">
    <h2 class="text-3xl md:text-4xl font-bold text-white">Featured Project</h2>
    <div class="h-px bg-gray-800 flex-grow"></div>
  </div>

  <div class="relative group">
    <div class="absolute -inset-0.5 bg-gradient-to-r from-cyan-600 to-blue-600 rounded-2xl blur opacity-20 group-hover:opacity-40 transition duration-500"></div>
    
    <div class="relative bg-gray-900 border border-gray-800 rounded-2xl p-8 md:p-10 flex flex-col md:flex-row gap-8 items-start">
      
      <div class="flex-1 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-900/30 text-blue-400 text-xs font-semibold border border-blue-800/50">
          <span>AI / Computer Vision</span>
        </div>
        
        <h3 class="text-2xl md:text-3xl font-bold text-white leading-tight">
          Medical Image Deepfake Detection <br/> 
          <span class="text-cyan-400">using YOLOv11</span>
        </h3>
        
        <p class="text-gray-400 leading-relaxed text-lg">
          A deepfake manipulation detection system for medical imagery utilizing the state-of-the-art <strong>You Only Look Once (YOLO) version 11</strong> architecture. This research focuses on high-precision anomaly identification to ensure data integrity within healthcare and cloud environments.
        </p>

        <div class="flex flex-wrap gap-2 pt-2">
          {['YOLOv11', 'Python', 'Computer Vision', 'Deep Learning', 'PyTorch'].map((tech) => (
            <span class="px-3 py-1 bg-gray-800 text-gray-300 text-sm rounded-md border border-gray-700">
              {tech}
            </span>
          ))}
        </div>
      </div>

      <div class="w-full md:w-1/3 bg-gray-950 rounded-xl p-6 border border-gray-800/50 shadow-inner">
        <h4 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">Project Highlights</h4>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-cyan-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span class="text-gray-300 text-sm">Implemented YOLOv11 for high-speed, real-time object inference.</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-cyan-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span class="text-gray-300 text-sm">Focused on combating data poisoning and securing digital medical records.</span>
          </li>
        </ul>
        <div class="mt-6 pt-6 border-t border-gray-800">
          <a href="/portfolio/projects/medical-deepfake-yolov11" class="group text-cyan-400 hover:text-cyan-300 text-sm font-medium flex items-center gap-2 transition-all">
            Read Case Study 
            <span class="transform transition-transform group-hover:translate-x-1">&rarr;</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>