      </div>
    </div>

    <div class="mt-8 flex flex-col-reverse items-center justify-between gap-4 border-t border-gray-800/50 pt-8 sm:flex-row text-xs text-gray-500">
      <p>&copy; {currentYear} Pancadrya. All rights reserved.</p>
      
      <div class="flex items-center gap-2 rounded-full border border-gray-800 bg-gray-900 px-3 py-1">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
        </span>
        <span class="text-gray-400">Built in Bandung, ID</span>
      </div>
    </div>
  </div>
</footer>